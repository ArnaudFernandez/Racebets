# syntax=docker/dockerfile:1.7

ARG MAVEN_IMAGE=maven:3.9-eclipse-temurin-25@sha256:7e461cec477077c1d9e50b13df8aef9018764410f4c4cd7c34803f10c4c99e4c

ARG RUNTIME_IMAGE=eclipse-temurin:25.0.4_7-jre-alpine-3.24@sha256:3137541deb3cac6626b5d9a4a2187bc0d6a34312f858bd2c67dd01e732e6b682


FROM ${MAVEN_IMAGE} AS build

WORKDIR /workspace

COPY pom.xml ./
COPY src ./src

RUN --mount=type=cache,target=/root/.m2 \
    mvn -B -DskipTests package


FROM ${RUNTIME_IMAGE} AS runtime

WORKDIR /app

RUN apk upgrade --no-cache \
    && apk add --no-cache curl \
    && addgroup -S -g 10001 appuser \
    && adduser -S -D -H -u 10001 -G appuser -s /sbin/nologin appuser \
    && install -d -o appuser -g appuser /var/lib/racebets/race-images

COPY --from=build \
    --chown=appuser:appuser \
    /workspace/target/*.jar \
    /app/app.jar

ENV JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=75.0 -Djava.io.tmpdir=/tmp" \
    SERVER_PORT=8080

EXPOSE 8080

USER appuser

HEALTHCHECK \
    --interval=15s \
    --timeout=5s \
    --start-period=30s \
    --retries=5 \
    CMD curl --fail --silent --show-error http://localhost:8080/api/app/features > /dev/null || exit 1

ENTRYPOINT ["java", "-jar", "/app/app.jar"]