BACKEND_IMAGE=ghcr.io/arnaudfernandez/racebets/backend:prod-<full-commit-sha>
FRONTEND_IMAGE=ghcr.io/arnaudfernandez/racebets/frontend:prod-<full-commit-sha>
OLIFAN_REDIRECT_URL=https://olifan.pixsom.fr
POSTGRES_DB=racebets_production
POSTGRES_USER=racebets
POSTGRES_PASSWORD=<generate-a-long-random-password>
JWT_SECRET=<generate-at-least-32-random-bytes>
JWT_EXPIRATION=86400000
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=<production-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<production-google-oauth-client-secret>
GOOGLE_LOGIN_CODE_TTL=PT1M
AUTH_MAX_ATTEMPTS=10
AUTH_ATTEMPT_WINDOW=PT15M
AUTH_BLOCK_DURATION=PT15M
AUTH_MAX_TRACKED_ACCOUNTS=100000
TRUSTED_PROXY_CIDR=<exact-traefik-network-cidr>
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
SPRING_FLYWAY_BASELINE_VERSION=1
SPRING_DATASOURCE_MAX_POOL_SIZE=20
SPRING_DATASOURCE_MIN_IDLE=5
SPRING_DATASOURCE_CONNECTION_TIMEOUT=3000
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Djava.io.tmpdir=/tmp
RACEBETS_DEV_ADMIN_ENABLED=false
RACEBETS_DEV_ADMIN_EMAIL=
RACEBETS_DEV_ADMIN_ACCESS_CODE=
