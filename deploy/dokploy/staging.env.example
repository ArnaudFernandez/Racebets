BACKEND_IMAGE=ghcr.io/arnaudfernandez/racebets/backend:staging-<full-commit-sha>
FRONTEND_IMAGE=ghcr.io/arnaudfernandez/racebets/frontend:staging-<full-commit-sha>
POSTGRES_DB=racebets_staging
POSTGRES_USER=racebets
POSTGRES_PASSWORD=<generate-a-long-random-password>
JWT_SECRET=<generate-at-least-32-random-bytes>
JWT_EXPIRATION=86400000
GOOGLE_AUTH_ENABLED=true
GOOGLE_CLIENT_ID=<staging-google-oauth-client-id>
GOOGLE_CLIENT_SECRET=<staging-google-oauth-client-secret>
GOOGLE_LOGIN_CODE_TTL=PT1M
SPRING_JPA_HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_BASELINE_ON_MIGRATE=true
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=75.0 -Djava.io.tmpdir=/tmp
RACEBETS_DEV_ADMIN_ENABLED=false
RACEBETS_DEV_ADMIN_EMAIL=
RACEBETS_DEV_ADMIN_ACCESS_CODE=
